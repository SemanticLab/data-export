      }
    ],
    "description": [
      {
        "@value": "E.A.T.-adjacent: Beverly Pepper recalls working inside U.S. Steel in the mid-1960s, using its new Cor-Ten and showing Barnett Newman how to patinate it, and casting a huge ductile-iron wedge in John Deere's Moline foundry."
      }
    ]
