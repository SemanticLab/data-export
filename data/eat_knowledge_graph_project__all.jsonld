    "description": [
      {
        "@value": "About an E.A.T. project: Christopher Rauschenberg recalls being a ball boy with Christine Williams in Robert Rauschenberg's Open Score at 9 Evenings, with Frank Stella, Mimi Kanarek, wired rackets and infrared cameras."
      }
    ]
