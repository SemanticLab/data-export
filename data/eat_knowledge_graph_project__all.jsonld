    "description": [
      {
        "@value": "About an E.A.T. project: Mel Bochner recalls his residency at the Singer laboratory in New Jersey, where talks with its engineers and mathematicians shaped his ideas on measurement, ahead of the E.A.T. survey in Seoul."
      }
    ]
