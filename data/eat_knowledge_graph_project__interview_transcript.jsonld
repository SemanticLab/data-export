    "description": [
      {
        "@value": "About an E.A.T. project: Robert Rauschenberg on how Oracle grew out of his radio painting Broadcast, why he needed technical help with remote-controlled radios, and his liking for mixing technology and aesthetics with live radio sound."
      }
    ]
