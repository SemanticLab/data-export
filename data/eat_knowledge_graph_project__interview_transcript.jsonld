    "description": [
      {
        "@value": "E.A.T.-adjacent: Fletcher Benton rejects Thomas Albright's 'high-tech' label for his clock-motor kinetic sculpture, contrasting it with Rauschenberg's mud-bubbling piece in Maurice Tuchman's show, and credits Fred Spratt."
      }
    ]
